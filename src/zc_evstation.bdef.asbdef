projection;
strict ( 2 );
use draft;

define behavior for ZC_EVSTATION alias Evstation
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Slot { create; with draft; }
}

define behavior for ZC_EVSLOT alias Evsolt
{
  use update;
  use delete;

  use association _Station { with draft; }
}